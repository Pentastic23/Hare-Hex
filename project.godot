; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hare&Hex"
run/main_scene="res://scenes/splash.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043137256, 0.047058824, 0.07058824, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://icon.png"
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

GameState="*uid://b7y0sg7soaxgc"
Events="*uid://detatr85kmhx1"
TouchControls="*res://Scripts/touch_controls.gd"
GamepadControls="*res://Scripts/gamepad_controls.gd"
ScreenFilter="*res://Scripts/screen_filter.gd"
Music="*res://Scripts/music.gd"
Sfx="*res://Scripts/sfx.gd"
LobbyNet="*res://Scripts/lobby/lobby_net.gd"
BugReporter="*res://scenes/BugReportUI.tscn"
Telemetry="*res://Scripts/telemetry.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

timers/tooltip_delay_sec=0.1
theme/custom="res://tres/ui_theme.tres"
timers/tooltip_delay_sec.mobile=10000.0

[layer_names]

3d_physics/layer_1="Tiles"
3d_physics/layer_2="Units"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043137256, 0.047058824, 0.07058824, 1)
