func _init() -> void:
	var force := OS.get_cmdline_user_args().has("--force")
	var made := 0
	for id in ITEMS:
		var path := "res://textures/ui/items/%s.png" % id
		if FileAccess.file_exists(path) and not force:
			continue
		var item := load("res://tres/items/%s.tres" % id) as ItemData
		if item == null:
			push_error("no item %s" % id)
			continue
		var img := _draw(SHAPES[ITEMS[id][0]], item.color, ITEMS[id][1])
		img.save_png(ProjectSettings.globalize_path(path))
		made += 1
	print("made %d icons" % made)
	quit()

func _draw(rows: Array, main: Color, accent: Color) -> Image:
	var pal := {
		"1": main, "2": main.lightened(0.3), "3": main.darkened(0.35), "a": accent,
		"g": Color("9aa0ad"), "G": Color("d8dce6"), "b": Color("7a4f2a"), "B": Color("a8743f"),
		"y": Color("f2c14e"), "w": Color("ffffff"),
	}
	var small := Image.create(N, N, false, Image.FORMAT_RGBA8)
	small.fill(Color(0, 0, 0, 0))
	for y in N:
		var row: String = rows[y]
		for x in N:
			var ch := row[x]
			if pal.has(ch):
				small.set_pixel(x, y, pal[ch])
	# a one-pixel outline round the shape, in the 16 px grid like the other placeholder icons
	var out := small.duplicate() as Image
	for y in N:
		for x in N:
			if small.get_pixel(x, y).a > 0.0:
				continue
			for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
				var p: Vector2i = Vector2i(x, y) + d
				if p.x >= 0 and p.y >= 0 and p.x < N and p.y < N and small.get_pixelv(p).a > 0.0:
					out.set_pixel(x, y, OUTLINE)
					break
	out.resize(N * SCALE, N * SCALE, Image.INTERPOLATE_NEAREST)
	return out
