# Godot 4+ specific ignores
.godot/
/android/

# Bug report webhook (a secret: anyone with it can post to the Discord channel)
bug_report_webhook.txt
docs/bug_report_webhook.md

#DISCORD_WEBHOOK
Github release webhook.txt

# Exported builds (too big for git; GitHub refuses files over 100 MB): attach them to a release instead
*.exe
*.apk
*.apk.idsig
*.pck

# Release builds (tools/release.ps1) and the GitHub token it uploads with (a secret)
/build/
release_token.txt

# Telemetry the launcher's STATS panel downloads (testers' data: keep it off GitHub)
/telemetry/
