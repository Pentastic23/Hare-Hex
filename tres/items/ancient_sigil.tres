[resource]
script = ExtResource("1_item")
id = &"ancient_sigil"
display_name = "Ancient Sigil"
description = "Put it on a 3-star unit. Each win that unit survives adds a mark; at 8 marks it ascends to 4 stars and the sigil is used up. Very rare."
